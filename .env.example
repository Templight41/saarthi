# --- Core ---
DATABASE_URL=postgresql+asyncpg://saarthi:saarthi@localhost:5432/saarthi
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
INTERNAL_API_TOKEN=dev-internal-token
SEED_ON_STARTUP=true

# --- LLM (gemini | sarvam | mock) ---
LLM_PROVIDER=mock

# Gemini backend: "vertex" for a Google Cloud project, "developer" for an
# AI Studio key. Vertex uses Application Default Credentials, so run
#   gcloud auth application-default login
# and set the project below. No API key is needed for Vertex.
GEMINI_BACKEND=developer
GOOGLE_CLOUD_PROJECT=
# Gemini 3.x is served from the global endpoint; regional ones 404.
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.6

# --- Memory (auto | pgvector | local) ---
MEMORY_PROVIDER=auto
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Workflows (auto | n8n | local) ---
WORKFLOW_ENGINE=auto
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
SCHEDULED_REFUND_WAIT_SECONDS=20
SCHEDULED_REFUND_THRESHOLD_SECONDS=60

# --- Voice in (auto | gemini | sarvam | faster_whisper | mock) ---
VOICE_PROVIDER=auto
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-preview
SARVAM_STT_MODEL=saaras:v3
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
VOICE_LANGUAGE=en-IN
VOICE_MAX_SECONDS=30

# --- Voice out (off | sarvam | mock) ---
# Sarvam's bulbul, because it speaks the Indian languages merchants use. The
# app refuses to start on TTS_PROVIDER=sarvam with no key: set TTS_PROVIDER=off
# if you do not want speech output at all.
TTS_PROVIDER=sarvam
# bulbul:v2 is deprecated and rejected by the live API. Speakers are tied to
# the model: v2's `anushka` is refused by v3.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# Blank inherits VOICE_LANGUAGE. A merchant's own language overrides both.
TTS_LANGUAGE=
TTS_SAMPLE_RATE=22050
TTS_MAX_CHARACTERS=1500
# v3 only. Low, so a message about someone's money is not read differently
# every time it is played.
TTS_TEMPERATURE=0.3
TTS_PACE=1.0

# --- Agent ---
AGENT_RUN_MODE=background
AGENT_STEP_DELAY_SECONDS=0.4

# --- Simulation ---
FAIL_FIRST_REFUND=false

# --- Metrics ---
HUMAN_HOURS_SAVED_PER_CASE=0.75
