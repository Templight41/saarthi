{
  "name": "Saarthi \u00b7 Case memory ingestion",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "saarthi/case-resolved",
        "responseMode": "onReceived",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "name": "Case resolved",
      "webhookId": "saarthi-case-resolved"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SAARTHI_API_BASE }}/api/internal/cases/{{ ($json.body ?? $json).case_id }}/memory-document",
        "sendBody": false,
        "specifyBody": "json",
        "jsonBody": "",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Saarthi-Internal-Token",
              "value": "={{ $env.SAARTHI_INTERNAL_TOKEN }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "name": "Fetch memory document"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SAARTHI_API_BASE }}/api/internal/memory/ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"case_id\": \"{{ ($('Case resolved').item.json.body ?? $('Case resolved').item.json).case_id }}\", \"run_id\": \"{{ ($('Case resolved').item.json.body ?? $('Case resolved').item.json).run_id }}\"}",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Saarthi-Internal-Token",
              "value": "={{ $env.SAARTHI_INTERNAL_TOKEN }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "name": "Ingest into memory"
    }
  ],
  "connections": {
    "Case resolved": {
      "main": [
        [
          {
            "node": "Fetch memory document",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch memory document": {
      "main": [
        [
          {
            "node": "Ingest into memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "On resolution, build the case memory document and write it to the semantic store."
  },
  "id": "saarthi-memory-ingest"
}